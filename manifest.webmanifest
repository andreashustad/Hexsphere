{
  "name": "VibeMine",
  "short_name": "VibeMine",
  "description": "Minesweeper on a rotating globe of hexagons. Guaranteed guess-free boards, fully offline, no ads.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#070b18",
  "theme_color": "#070b18",
  "categories": ["games", "puzzle"],
  "lang": "en",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Daily challenge", "short_name": "Daily", "url": "./index.html?mode=daily", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "New game", "short_name": "New", "url": "./index.html?new=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
